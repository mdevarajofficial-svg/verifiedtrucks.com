rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function adminEmail() {
      return signedIn() && request.auth.token.email in [
        'mdevaraj159@gmail.com',
        'mdevarajofficial@gmail.com'
      ];
    }
    function adminPhone() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone in [
          '6363655596',
          '9113265599'
        ];
    }
    function isAdmin() {
      return adminEmail() || adminPhone();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /loads/{loadId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && !('contactPhone' in request.resource.data);
      allow update: if signedIn() && (
        isAdmin() ||
        (
          resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedBidId', 'acceptedBidderUid', 'booked', 'contactReleased', 'bookedAt'])
        ) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lowestBidAmount', 'lowestBidderUid', 'lowestBidId', 'bidCount'])
      );
      allow delete: if false;
    }

    match /loadPrivate/{loadId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid;
      allow read, update: if signedIn() && (
        isAdmin() || resource.data.customerUid == request.auth.uid
      );
      allow delete: if false;
    }

    match /bids/{bidId} {
      allow create: if signedIn()
        && request.resource.data.bidderUid == request.auth.uid;
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.bidderUid == request.auth.uid ||
        (
          get(/databases/$(database)/documents/loads/$(resource.data.loadId)).data.customerUid == request.auth.uid
          && get(/databases/$(database)/documents/loads/$(resource.data.loadId)).data.contactReleased == true
          && get(/databases/$(database)/documents/loads/$(resource.data.loadId)).data.acceptedBidId == bidId
        )
      );
      allow update: if signedIn() && (
        isAdmin() || resource.data.bidderUid == request.auth.uid
      );
      allow delete: if false;
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read: if true;
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['booked', 'bookedAt', 'status'])
        && request.resource.data.booked == true
      );
      allow delete: if false;
    }

    match /mail/{mailId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.to.size() == 1
        && request.resource.data.to[0] == request.auth.token.email;
      allow read, update, delete: if false;
    }
  }
}
