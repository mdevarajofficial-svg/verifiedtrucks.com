rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public marketplace reads; writes allowed for demo (tighten with auth later if needed)
    match /loads/{loadId} {
      allow read, write: if true;
    }

    // User profiles: owner can read/write their own doc; VIP/admin can read all via client gate
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Lead capture form submissions (truck booking)
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll([
          'loadingLocation', 'unloadingLocation', 'sizeFeet', 'bodyType',
          'tonnage', 'contactName', 'contactPhone', 'source'
        ])
        && request.resource.data.loadingLocation is string
        && request.resource.data.unloadingLocation is string
        && request.resource.data.contactName is string
        && request.resource.data.contactPhone is string;
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['booked', 'bookedAt', 'status'])
        && request.resource.data.booked == true
        && request.resource.data.status == 'booked';
      allow delete: if false;
    }

    // Outbound email queue (Firebase Trigger Email extension reads /mail)
    match /mail/{mailId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.to.size() == 1
        && request.resource.data.to[0] == request.auth.token.email;
      allow read, update, delete: if false;
    }
  }
}
