rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function adminEmail() {
      return signedIn() && request.auth.token.email in [
        'mdevaraj159@gmail.com',
        'mdevarajofficial@gmail.com'
      ];
    }
    function adminPhone() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone in [
          '6363655596',
          '9113265599'
        ];
    }
    function isAdmin() {
      return adminEmail() || adminPhone();
    }
    function bookedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['booked', 'bookedAt', 'status'])
        && request.resource.data.booked == true;
    }
    function bidStatKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['lowestBidAmount', 'lowestBidderUid', 'lowestBidId', 'bidCount']);
    }
    function isPoster() {
      return signedIn() && (
        resource.data.posterUid == request.auth.uid ||
        resource.data.customerUid == request.auth.uid
      );
    }
    function posterAcceptKeys() {
      return isPoster() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'acceptedBidId', 'acceptedBidderUid', 'booked', 'contactReleased', 'bookedAt', 'lowestBidAmount', 'lowestBidderUid', 'lowestBidId', 'bidCount']);
    }
    function validBidPhone(data) {
      return (data.keys().hasAny(['phone']) && data.phone is string && data.phone.matches('^[0-9]{10}$'))
        || (data.keys().hasAny(['bidderPhone']) && data.bidderPhone is string && data.bidderPhone.matches('^[0-9]{10}$'));
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /loads/{loadId} {
      allow read: if true;
      allow create: if request.resource.data.loadingLocation is string
        && request.resource.data.unloadingLocation is string
        && request.resource.data.timerEndsAt is number
        && request.resource.data.status == 'open'
        && !('contactPhone' in request.resource.data);
      allow update: if isAdmin() || bookedKeys() || bidStatKeys() || posterAcceptKeys();
      allow delete: if isPoster() || isAdmin();
    }

    match /loadPrivate/{loadId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid;
      allow read, update: if signedIn() && (
        isAdmin() || resource.data.customerUid == request.auth.uid
      );
      allow delete: if signedIn() && (
        isAdmin() || resource.data.customerUid == request.auth.uid
      );
    }

    match /bids/{bidId} {
      allow read: if true;
      allow create: if request.resource.data.loadId is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && validBidPhone(request.resource.data)
        && request.resource.data.vehicleNumber is string
        && request.resource.data.vehicleNumber.size() >= 4
        && (!('bidderUid' in request.resource.data) || request.resource.data.bidderUid == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn() && resource.data.bidderUid == request.auth.uid
      ) || (
        signedIn()
        && exists(/databases/$(database)/documents/loads/$(resource.data.loadId))
        && (
          get(/databases/$(database)/documents/loads/$(resource.data.loadId)).data.posterUid == request.auth.uid
          || get(/databases/$(database)/documents/loads/$(resource.data.loadId)).data.customerUid == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.bidderUid == request.auth.uid)
        || (
          signedIn()
          && exists(/databases/$(database)/documents/loads/$(resource.data.loadId))
          && (
            get(/databases/$(database)/documents/loads/$(resource.data.loadId)).data.posterUid == request.auth.uid
            || get(/databases/$(database)/documents/loads/$(resource.data.loadId)).data.customerUid == request.auth.uid
          )
        );
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read: if true;
      allow update: if isAdmin() || bookedKeys();
      allow delete: if false;
    }

    match /mail/{mailId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.to.size() == 1
        && request.resource.data.to[0] == request.auth.token.email;
      allow read, update, delete: if false;
    }
  }
}
