{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://verifiedtrucks.com/",
        "type": 301
      },
      {
        "regex": "^/([^_].+)$",
        "destination": "https://verifiedtrucks.com/:1",
        "type": 301
      }
    ],
    "rewrites": [
      { "source": "/about", "destination": "/about.html" },
      { "source": "/book-truck-online", "destination": "/book-truck-online.html" },
      { "source": "/transporters", "destination": "/routes.html" },
      { "source": "/transporters.html", "destination": "/routes.html" },
      { "source": "/truck-types", "destination": "/truck-types.html" },
      { "source": "/verify-truck", "destination": "/index.html" },
      { "source": "/verify-truck.html", "destination": "/index.html" },
      { "source": "/profile", "destination": "/profile.html" },
      { "source": "/routes", "destination": "/routes.html" },
      { "source": "/vip", "destination": "/index.html" },
      { "source": "/vip.html", "destination": "/index.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
        ]
      }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Verified Trucks",
        "supportEmail": "mdevarajofficial@gmail.com"
      }
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
