{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/about", "destination": "/about.html" },
      { "source": "/book-truck-online", "destination": "/book-truck-online.html" },
      { "source": "/transporters", "destination": "/about.html" },
      { "source": "/transporters.html", "destination": "/about.html" },
      { "source": "/truck-types", "destination": "/truck-types.html" },
      { "source": "/verify-truck", "destination": "/index.html" },
      { "source": "/verify-truck.html", "destination": "/index.html" },
      { "source": "/profile", "destination": "/profile.html" },
      { "source": "/vip", "destination": "/vip.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
        ]
      }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Verified Trucks",
        "supportEmail": "mdevarajofficial@gmail.com"
      }
    }
  }
}
